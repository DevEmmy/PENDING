# ---- Frontend (public, bundled into the browser) ----
# From Supabase dashboard → Project Settings → API. Only the public anon/publishable key goes here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional: base path the app is served from (GitHub Pages default is /VENDORA/)
# VITE_BASE=/VENDORA/

# ---- Server-only (Supabase Edge Function secrets) ----
# NEVER prefix these with VITE_ and never commit real values.
# Set them with: supabase secrets set YARNGPT_API_KEY=... YARNGPT_DEFAULT_VOICE=...
# YARNGPT_API_KEY=sk_live_xxxx.xxxxxxxx
# YARNGPT_BASE_URL=https://yarngpt.ai
# YARNGPT_DEFAULT_VOICE=          # leave empty to use the voice marked default:true by GET /api/v1/voices
# YARNGPT_DAILY_LIMIT_PER_USER=60
